PORT=5000
# For MongoDB Compass (Local MongoDB instance)
MONGODB_URI=mongodb://127.0.0.1:27017/civic_resolve

# When you want to switch to MongoDB Atlas later, uncomment and replace with your Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/civic_resolve?retryWrites=true&w=majority

JWT_SECRET=civic_resolve_secret_jwt_key_2026_super_secure
JWT_EXPIRE=30d
NODE_ENV=development
