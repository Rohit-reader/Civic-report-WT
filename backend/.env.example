PORT=5000

# -------------------------------------------------------------
# 1. LOCAL DATABASE (MongoDB Compass)
# -------------------------------------------------------------
# Open MongoDB Compass -> Click "Connect" to mongodb://localhost:27017 or mongodb://127.0.0.1:27017
# Your database 'civic_resolve' will appear in MongoDB Compass!
MONGODB_URI=mongodb://127.0.0.1:27017/civic_resolve

# -------------------------------------------------------------
# 2. CLOUD DATABASE (MongoDB Atlas - for production/cloud)
# -------------------------------------------------------------
# Replace with your connection string from MongoDB Atlas Dashboard -> Database -> Connect -> Drivers:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/civic_resolve?retryWrites=true&w=majority

JWT_SECRET=civic_resolve_secret_jwt_key_2026_super_secure
JWT_EXPIRE=30d
NODE_ENV=development
